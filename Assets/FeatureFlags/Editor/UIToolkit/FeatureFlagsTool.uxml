            <ui:Label tabindex="-1" text="Label" parse-escape-sequences="true" display-tooltip-when-elided="true" name="AppVersionLabel" style="-unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;);"/>
        </ui:VisualElement>
        <ui:VisualElement name="Options" style="height: 20%; border-bottom-width: 2px; border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-top-color: rgb(0, 0, 0);">
            <ui:Label text="Tabs" display-tooltip-when-elided="true" name="Options" style="-unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;);"/>
