<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="Window" style="flex-grow: 1; height: 720px; -unity-background-image-tint-color: rgb(65, 174, 207); background-color: rgba(55, 55, 55, 0.42); background-image: none;">
        <ui:VisualElement name="Logo" style="height: 90px; background-image: none; width: 100%; align-items: center; background-color: rgb(174, 101, 245); position: relative;">
            <ui:Label tabindex="-1" text="Feature Flags Manager" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-font: url(&quot;project://database/Packages/com.genies.uiframework.internal/Art/Fonts/Roobert/Roobert-Bold.otf?fileID=12800000&amp;guid=fbe7a11dffb1873428cdcb7274be3773&amp;type=3#Roobert-Bold&quot;); position: absolute; top: 5px; left: 0; color: rgb(0, 0, 0); -unity-font-style: bold; font-size: 18px; -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;);"/>
        </ui:VisualElement>
        <ui:VisualElement name="EnablingTool" style="height: 15%; border-bottom-width: 1px; border-bottom-color: rgb(0, 0, 0); border-top-width: 1px; border-top-color: rgb(0, 0, 0); margin-top: 2px;">
            <ui:Toggle label="Enabling Tool" name="EnablingToggle" style="-unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;);"/>
